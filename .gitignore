# Byte-compiled / cache
__pycache__/
*.py[cod]

# Віртуальне середовище
.venv/
venv/

# Кеш Ruff
.ruff_cache/

# Дані, що створюються динамічно (бази, журнали)
labs/*/data/*.csv
labs/*/data/*.json
labs/*/data/*.log
*.db

# IDE / системні файли
.vscode/
.idea/
.DS_Store
Thumbs.db

# ЛР №3: робочий файл SQLite створюється програмою
labs/lab03/data/*.sqlite3
labs/lab03/data/*.sqlite3-*
labs/lab03/data/*.db
labs/lab03/data/*.db-*
# Початкові дані ЛР №3 мають бути в Git
!labs/lab03/data/seed.json
